# Server Configuration
PORT=3001
NODE_ENV=development
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://bingooo_user:bingooo_secure_password_2026@localhost:5432/bingooo_db?schema=public"

# Security & Tokens
JWT_ADMIN_SECRET="bingooo_dev_super_secret_jwt_admin_key_2026_xyz"
JWT_CUSTOMER_SECRET="bingooo_dev_customer_session_token_key_2026_abc"
JWT_EXPIRES_IN="1d"
CUSTOMER_SESSION_EXPIRES_HOURS=24

# Timezone (IST is mandatory for the monthly promotion calendar)
APP_TIMEZONE="Asia/Kolkata"

# OTP Verification Settings
MOCK_OTP_ENABLED=true
MOCK_OTP_CODE="123456"
OTP_EXPIRATION_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# SMS Provider Credentials (Production only: MSG91 / Fast2SMS / Twilio)
SMS_PROVIDER="mock"
SMS_API_KEY=""
SMS_SENDER_ID=""
SMS_TEMPLATE_ID=""

# Store Info
STORE_NAME="BINGOOO"
STORE_CITY="Srikakulam"
STORE_STATE="Andhra Pradesh"
STORE_DOMAIN="bingooo.co.in"
