# Production Environment Configuration for BINGOOO Rewards Club
# Copy this file to .env on your hosting server (Railway, Render, VPS)

# Server Port & Mode
PORT=3001
NODE_ENV=production

# URLs (Point to your live custom domains)
APP_URL=https://api.bingooo.co.in
FRONTEND_URL=https://bingooo.co.in

# Cloud Database URL (Neon.tech, Supabase, Railway, AWS RDS)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://bingooo_admin:YOUR_SECURE_PASSWORD@ep-summer-pool-123456.us-east-2.aws.neon.tech/bingooo_db?sslmode=require"

# JWT Authentication Secrets (Generate with: openssl rand -base64 32)
JWT_ADMIN_SECRET="bingooo_prod_jwt_admin_secret_replace_with_random_key_2026"
JWT_CUSTOMER_SECRET="bingooo_prod_jwt_customer_secret_replace_with_random_key_2026"
JWT_EXPIRES_IN="1d"
CUSTOMER_SESSION_EXPIRES_HOURS=24

# Timezone & Regional Settings
APP_TIMEZONE="Asia/Kolkata"

# Brand Information
STORE_NAME="BINGOOO"
STORE_CITY="Srikakulam"
STORE_STATE="Andhra Pradesh"
STORE_DOMAIN="bingooo.co.in"

# SMS / WhatsApp Notifications (Optional Provider Keys)
SMS_PROVIDER="mock"
SMS_API_KEY=""
SMS_SENDER_ID="BGOVIP"
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
