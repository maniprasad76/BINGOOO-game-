{
  "name": "bingooo-spin-win-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:web": "npm run dev --workspace=@bingooo/web",
    "dev:api": "npm run start:dev --workspace=@bingooo/api",
    "build:shared": "npm run build --workspace=@bingooo/shared",
    "build": "npm run build --workspace=@bingooo/shared && npm run build --workspace=@bingooo/api && npm run build --workspace=@bingooo/web",
    "postinstall": "npm run build:shared && npm run db:generate",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "db:migrate": "npm run prisma:migrate --workspace=@bingooo/api",
    "db:seed": "npm run prisma:seed --workspace=@bingooo/api",
    "db:generate": "npm run prisma:generate --workspace=@bingooo/api"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
